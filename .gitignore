# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Environment / secrets - never commit these
.env
.env.*
*.env
!.env.example

# Logs / temp
*.log
*.tmp
**/tmp/*
**/temp/*
!**/tmp/.keep
!**/tmp/.gitkeep
!**/temp/.keep
!**/temp/.gitkeep

# AI coding agents (personal, local-only files)
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/album/
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md
# Claude Code
CLAUDE.local.md
# Codex
/AGENTS.override.md
# Gemini CLI: .gemini/.env is already covered by the .env rules above

# Skill outputs (automatically archived)
/.zenuml/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Generated albums (except the example, remade by make_example.ps1)
*_album.pdf
!/examples/photos_album.pdf

# Build (build_portable.ps1)
.build-venv/
build/

# The bundled program is committed as-is, even its .pyc files
!/app/**
